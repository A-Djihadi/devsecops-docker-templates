# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` — it is already covered by the repository's `.gitignore`.

# ─── Project ────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=myproject

# ─── Application ────────────────────────────────────────────────────────────
# Production image (pin an explicit, immutable tag).
APP_IMAGE=myapp:1.0.0
# Non-root UID/GID the app container runs as (matches the repo templates: 1000).
APP_UID=1000
APP_GID=1000
# Health endpoint served by the app:
#   - /healthz            for the Angular/React nginx templates
#   - /actuator/health    for Spring Boot with Actuator
APP_HEALTHCHECK_PATH=/healthz
# Development only: host port for direct app access (container always 8080).
APP_PORT=8080
# Development only: path to the app Dockerfile relative to the repo root
# (e.g. angular/Dockerfile, react/Dockerfile, java-spring-boot/Dockerfile).
APP_DOCKERFILE=Dockerfile

# ─── Database ───────────────────────────────────────────────────────────────
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=change-me-in-production
# Development only: host port exposed for PostgreSQL.
DB_PORT=5432

# ─── Proxy ──────────────────────────────────────────────────────────────────
# Host port published by the nginx reverse proxy (container always listens on 8080).
PROXY_PORT=80
